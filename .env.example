# Copy to .env (local) / .env.docker (compose) and fill in.

# Mongo connection string used by the app and the seed script.
# Local:  mongodb://<user>:<pass>@localhost:27017/inminutes?authSource=admin
# Docker: mongodb://<user>:<pass>@mongo:27017/inminutes?authSource=admin
MONGO_URI=

# Root credentials for the mongo container (.env.docker only — nothing in the
# app itself reads these, only MONGO_URI above). MONGO_INITDB_ROOT_USERNAME/
# PASSWORD are the exact names the official mongo image's entrypoint reads to
# create that user on its first start; docker-compose.yaml hands it this whole
# file via env_file. Keep both equal to the user:pass already in MONGO_URI.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=


# --- Media storage (Cloudinary) ---
# The backend stores and serves image URLs only; it never uploads. Product image
# URLs are built as:
#   <BASE_URL>/<CLOUD_NAME>/image/upload/<TRANSFORM>/<FOLDER>/<product-slug>.<FORMAT>
# (the /<FOLDER> segment is only inserted when CLOUDINARY_FOLDER is non-empty)
# Leave CLOUDINARY_CLOUD_NAME empty to run without images (image_urls comes back []).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_BASE_URL=https://res.cloudinary.com
# Leave this empty unless your account uses the older Fixed/Rigid folder mode.
CLOUDINARY_FOLDER=
CLOUDINARY_IMAGE_FORMAT=jpg
CLOUDINARY_THUMB_TRANSFORM=c_fill,w_400,h_400,q_auto,f_auto
CLOUDINARY_FULL_TRANSFORM=c_fill,w_1200,h_800,q_auto,f_auto
